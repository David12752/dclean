<Application x:Class="DClean.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DClean.UI.Converters"
             xmlns:vm="clr-namespace:DClean.UI.ViewModels"
             xmlns:views="clr-namespace:DClean.UI.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DCleanTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ViewModel → View DataTemplates -->
            <DataTemplate DataType="{x:Type vm:UninstallerViewModel}">
                <views:UninstallerView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PerformanceTunerViewModel}">
                <views:PerformanceTunerView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MftScannerViewModel}">
                <views:MftScannerView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DebloaterViewModel}">
                <views:DebloaterView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ContextMenuViewModel}">
                <views:ContextMenuView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:WinGetUpdaterViewModel}">
                <views:WinGetUpdaterView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FullScanViewModel}">
                <views:FullScanView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DriverAuditorViewModel}">
                <views:DriverAuditorView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DawCleanerViewModel}">
                <views:DawCleanerView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AudioEndpointViewModel}">
                <views:AudioEndpointView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:NetworkFlushViewModel}">
                <views:NetworkFlushView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ComponentStoreViewModel}">
                <views:ComponentStoreView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SmartAnalyzerViewModel}">
                <views:SmartAnalyzerView/>
            </DataTemplate>

            <!-- Global converters -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <conv:InverseBoolConverter      x:Key="InverseBool"/>
            <conv:BytesFormatConverter      x:Key="BytesFormat"/>
            <conv:PercentFormatConverter    x:Key="PercentFormat"/>
            <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility"/>
            <conv:InverseBoolToVisibilityConverter     x:Key="InverseBoolToVisibility"/>
            <conv:IntToBoolConverter                   x:Key="IntToBool"/>
            <conv:IntToVisibilityConverter             x:Key="IntToVisibility"/>
            <conv:HealthScoreToLabelConverter          x:Key="HealthScoreToLabel"/>
            <conv:HealthScoreToBrushConverter          x:Key="HealthScoreToBrush"/>
            <conv:TemperatureToBrushConverter          x:Key="TemperatureToBrush"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
