<UserControl x:Class="DClean.UI.Views.FullScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DClean.UI.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- Header -->
            <TextBlock Text="סריקה מקיפה של המערכת" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="בדיקה מקבילה של כל המודולים — קבצי זבל, דרייברים, עדכונים, כוננים, שמע ועוד"
                       Foreground="#A0A0B0" FontSize="13" Margin="0,0,0,20"/>

            <!-- Action Bar -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,14">
                        <Button Command="{Binding ScanAllCommand}"
                                IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}"
                                Padding="18,10" Margin="0,0,10,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Setter Property="Background" Value="#1A6B3A"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#22884A"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="סרוק את כל המערכת" FontSize="15" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Content="⏹ בטל" Command="{Binding CancelCommand}"
                                IsEnabled="{Binding IsScanning}"
                                Style="{StaticResource GhostButtonStyle}" Padding="12,10"/>
                    </WrapPanel>

                    <!-- Progress -->
                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="8"
                                 Margin="0,0,0,8">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Progress}" Value="100">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>

                    <TextBlock Text="{Binding StatusText}" FontSize="13"
                               Foreground="{StaticResource ForegroundBrush}"/>
                </StackPanel>
            </Border>

            <!-- Summary Badges — only show after scan -->
            <Border Style="{StaticResource CardStyle}"
                    Visibility="{Binding HasScanned, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Critical -->
                    <Border Grid.Column="0" CornerRadius="10" Padding="16,14" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#1A0808"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CriticalCount}" Value="0">
                                        <Setter Property="Background" Value="#1A1A1A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding CriticalCount}" FontSize="36" FontWeight="Bold"
                                       HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#CC3333"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CriticalCount}" Value="0">
                                                <Setter Property="Foreground" Value="#555"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="בעיות קריטיות" FontSize="12" HorizontalAlignment="Center"
                                       Foreground="#A0A0B0"/>
                        </StackPanel>
                    </Border>

                    <!-- Warning -->
                    <Border Grid.Column="1" CornerRadius="10" Padding="16,14" Margin="4,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#1A1400"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WarningCount}" Value="0">
                                        <Setter Property="Background" Value="#1A1A1A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding WarningCount}" FontSize="36" FontWeight="Bold"
                                       HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFB900"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WarningCount}" Value="0">
                                                <Setter Property="Foreground" Value="#555"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="אזהרות" FontSize="12" HorizontalAlignment="Center"
                                       Foreground="#A0A0B0"/>
                        </StackPanel>
                    </Border>

                    <!-- Info -->
                    <Border Grid.Column="2" CornerRadius="10" Padding="16,14" Margin="8,0,0,0"
                            Background="#0E1A26">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding InfoCount}" FontSize="36" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="פריטי מידע" FontSize="12" HorizontalAlignment="Center"
                                       Foreground="#A0A0B0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Critical Findings -->
            <Border Style="{StaticResource CardStyle}"
                    Visibility="{Binding CriticalCount, Converter={StaticResource IntToVisibility}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="🔴" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="בעיות קריטיות" FontSize="16" FontWeight="Bold"
                                   Foreground="#CC3333" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding CriticalFindings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1A0808" CornerRadius="8" Padding="14,10"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#CC3333" CornerRadius="4"
                                                Padding="6,3" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Category}" FontSize="11"
                                                       Foreground="White" FontWeight="SemiBold"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                       Foreground="#FF6666" FontSize="13"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="#A0A0B0"
                                                       FontSize="11" Margin="0,2,0,0"
                                                       TextWrapping="Wrap"/>
                                            <StackPanel Margin="0,8,0,0"
                                                        Visibility="{Binding ProblematicItem, Converter={StaticResource StringNotEmptyToVisibility}}">
                                                <TextBlock Foreground="#C8CDD8" FontSize="10">
                                                    <Run Text="מקור: "/><Run Text="{Binding Source}"/>
                                                </TextBlock>
                                                <TextBlock Foreground="#C8CDD8" FontSize="10"
                                                           Visibility="{Binding RelatedApplication, Converter={StaticResource StringNotEmptyToVisibility}}">
                                                    <Run Text="אפליקציה: "/><Run Text="{Binding RelatedApplication}"/>
                                                </TextBlock>
                                                <TextBlock Foreground="#C8CDD8" FontSize="10"
                                                           Visibility="{Binding Location, Converter={StaticResource StringNotEmptyToVisibility}}"
                                                           TextWrapping="Wrap">
                                                    <Run Text="מיקום: "/><Run Text="{Binding Location}"/>
                                                </TextBlock>
                                                <TextBlock Foreground="#FFFFFF" FontSize="10"
                                                           Visibility="{Binding ProblematicItem, Converter={StaticResource StringNotEmptyToVisibility}}"
                                                           TextWrapping="Wrap">
                                                    <Run Text="קובץ/פריט: "/><Run Text="{Binding ProblematicItem}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Content="{Binding ActionLabel}"
                                                Command="{Binding DataContext.NavigateCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Padding="10,6" FontSize="12" Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding ActionLabel, Converter={StaticResource StringNotEmptyToVisibility}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Warning Findings -->
            <Border Style="{StaticResource CardStyle}"
                    Visibility="{Binding WarningCount, Converter={StaticResource IntToVisibility}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="🟡" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="אזהרות" FontSize="16" FontWeight="Bold"
                                   Foreground="#FFB900" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding WarningFindings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1A1400" CornerRadius="8" Padding="14,10"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#7A5800" CornerRadius="4"
                                                Padding="6,3" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Category}" FontSize="11"
                                                       Foreground="#FFD060" FontWeight="SemiBold"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                       Foreground="#FFB900" FontSize="13"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="#A0A0B0"
                                                       FontSize="11" Margin="0,2,0,0"
                                                       TextWrapping="Wrap"/>
                                            <StackPanel Margin="0,8,0,0"
                                                        Visibility="{Binding ProblematicItem, Converter={StaticResource StringNotEmptyToVisibility}}">
                                                <TextBlock Foreground="#C8CDD8" FontSize="10">
                                                    <Run Text="מקור: "/><Run Text="{Binding Source}"/>
                                                </TextBlock>
                                                <TextBlock Foreground="#C8CDD8" FontSize="10"
                                                           Visibility="{Binding RelatedApplication, Converter={StaticResource StringNotEmptyToVisibility}}">
                                                    <Run Text="אפליקציה: "/><Run Text="{Binding RelatedApplication}"/>
                                                </TextBlock>
                                                <TextBlock Foreground="#C8CDD8" FontSize="10"
                                                           Visibility="{Binding Location, Converter={StaticResource StringNotEmptyToVisibility}}"
                                                           TextWrapping="Wrap">
                                                    <Run Text="מיקום: "/><Run Text="{Binding Location}"/>
                                                </TextBlock>
                                                <TextBlock Foreground="#FFFFFF" FontSize="10"
                                                           Visibility="{Binding ProblematicItem, Converter={StaticResource StringNotEmptyToVisibility}}"
                                                           TextWrapping="Wrap">
                                                    <Run Text="קובץ/פריט: "/><Run Text="{Binding ProblematicItem}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Content="{Binding ActionLabel}"
                                                Command="{Binding DataContext.NavigateCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Padding="10,6" FontSize="12" Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding ActionLabel, Converter={StaticResource StringNotEmptyToVisibility}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Info Findings -->
            <Border Style="{StaticResource CardStyle}"
                    Visibility="{Binding InfoCount, Converter={StaticResource IntToVisibility}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="🔵" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="מידע ופעולות מומלצות" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding InfoFindings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0E1520" CornerRadius="8" Padding="14,10"
                                        Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#0E3048" CornerRadius="4"
                                                Padding="6,3" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Category}" FontSize="11"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource ForegroundBrush}"
                                                       FontSize="13"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="#A0A0B0"
                                                       FontSize="11" Margin="0,2,0,0"
                                                       TextWrapping="Wrap"/>
                                            <StackPanel Margin="0,8,0,0"
                                                        Visibility="{Binding ProblematicItem, Converter={StaticResource StringNotEmptyToVisibility}}">
                                                <TextBlock Foreground="#C8CDD8" FontSize="10">
                                                    <Run Text="מקור: "/><Run Text="{Binding Source}"/>
                                                </TextBlock>
                                                <TextBlock Foreground="#C8CDD8" FontSize="10"
                                                           Visibility="{Binding RelatedApplication, Converter={StaticResource StringNotEmptyToVisibility}}">
                                                    <Run Text="אפליקציה: "/><Run Text="{Binding RelatedApplication}"/>
                                                </TextBlock>
                                                <TextBlock Foreground="#C8CDD8" FontSize="10"
                                                           Visibility="{Binding Location, Converter={StaticResource StringNotEmptyToVisibility}}"
                                                           TextWrapping="Wrap">
                                                    <Run Text="מיקום: "/><Run Text="{Binding Location}"/>
                                                </TextBlock>
                                                <TextBlock Foreground="#FFFFFF" FontSize="10"
                                                           Visibility="{Binding ProblematicItem, Converter={StaticResource StringNotEmptyToVisibility}}"
                                                           TextWrapping="Wrap">
                                                    <Run Text="קובץ/פריט: "/><Run Text="{Binding ProblematicItem}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Content="{Binding ActionLabel}"
                                                Command="{Binding DataContext.NavigateCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Padding="10,6" FontSize="12" Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding ActionLabel, Converter={StaticResource StringNotEmptyToVisibility}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Empty state — before first scan -->
            <Border Style="{StaticResource CardStyle}"
                    Visibility="{Binding HasScanned, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" Margin="0,40,0,40">
                    <TextBlock Text="🔍" FontSize="64" HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>
                    <TextBlock Text="לחץ 'סרוק את כל המערכת' לבדיקה מקיפה"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource ForegroundBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center"
                               Foreground="#A0A0B0" FontSize="13" TextAlignment="Center">
                        הסריקה בודקת בו-זמנית:
                        קבצי זבל · תוכניות אתחול · עדכוני תוכנה · דרייברים
                        · S.M.A.R.T · WinSxS · DAW · שמע ופרטיות
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
