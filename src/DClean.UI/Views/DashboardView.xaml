<UserControl x:Class="DClean.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Page Header ══════════════════════════════════════════════ -->
        <Border Grid.Row="0" Padding="28,22,28,18"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="לוח בקרה"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource ForegroundBrush}"/>
                    <TextBlock Text="סריקה, ניקוי ומעקב אחר שימוש במשאבים"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>
                <!-- Connection status badge -->
                <Border Grid.Column="1" CornerRadius="20" Padding="12,6"
                        VerticalAlignment="Center"
                        BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#0E1A14"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Background" Value="#0A1F12"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <!-- Status dot -->
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource PrimaryBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConnectionStatus}" Value="שירות לא זמין">
                                            <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <!-- Status text -->
                        <TextBlock Text="{Binding ConnectionStatus}" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Retry button — only when failed -->
                        <Button Content="נסה שוב" Command="{Binding ConnectCommand}"
                                Padding="8,3" FontSize="11">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConnectionStatus}" Value="שירות לא זמין">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══ Scrollable Body ═══════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="28,20,28,24">
            <StackPanel>

                <!-- ══ Service starting banner ════════════════════════════ -->
                <Border CornerRadius="8" Padding="16,12" Margin="0,0,0,16"
                        Background="#0E2030"
                        Visibility="{Binding IsStartingService,
                            Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <ProgressBar IsIndeterminate="True" Width="120" Height="6"
                                     Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ══ Service NOT FOUND error banner ════════════════════ -->
                <Border CornerRadius="8" Padding="20,16" Margin="0,0,0,16"
                        Background="#1A0808" BorderBrush="#CC3333" BorderThickness="1"
                        Visibility="{Binding IsServiceNotFound,
                            Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="⚠️" FontSize="20" Margin="0,0,10,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="שירות DClean לא נמצא"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="#FF6666" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="#C0C0D0" FontSize="13"
                                   Margin="0,0,0,10">
                            לא נמצא קובץ DClean.Service.exe. כדי להפעיל את האפליקציה יש לבנות 
                            את כל הפרויקט תחילה.
                        </TextBlock>
                        <Border Background="#0D1015" CornerRadius="6" Padding="12,8"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="שלבים לבנייה:" FontSize="12"
                                           Foreground="#A0A0B0" Margin="0,0,0,6"/>
                                <TextBlock FontFamily="Consolas" FontSize="12"
                                           Foreground="#7EC8A0">
                                    dotnet build DClean.sln
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <WrapPanel>
                            <Button Content="🔄 נסה שוב (לאחר בנייה)"
                                    Command="{Binding StartServiceCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,0,10,0"/>
                            <Button Content="📂 פתח תיקיית שירות"
                                    Command="{Binding OpenServiceFolderCommand}"
                                    Style="{StaticResource GhostButtonStyle}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ══ Service disconnected (found but can't connect) ════ -->
                <Border CornerRadius="8" Padding="16,12" Margin="0,0,0,16"
                        Background="#1A1400" BorderBrush="#7A5800" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsConnected}"      Value="False"/>
                                        <Condition Binding="{Binding IsServiceNotFound}" Value="False"/>
                                        <Condition Binding="{Binding IsStartingService}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Foreground="{StaticResource WarningBrush}"
                                       FontSize="13" FontWeight="SemiBold">
                                🔌 השירות לא פועל — הסריקה לא תפעל
                            </TextBlock>
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="#A0A0B0" FontSize="12"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="🔄 הפעל שירות"
                                Command="{Binding StartServiceCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="14,8" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ══ Stat Cards Row ══════════════════════════════════════ -->
                <UniformGrid Rows="1" Columns="3" Margin="0,0,0,20">

                    <!-- RAM Usage card -->
                    <Border Style="{StaticResource StatCardStyle}" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="8,8,0,0"/>
                            <StackPanel Grid.Row="1" Margin="18,14,18,16">
                                <TextBlock Text="שימוש RAM"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding RamPercent,
                                               Converter={StaticResource PercentFormat}}"
                                           FontFamily="Consolas" FontSize="34" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Margin="0,0,0,10"/>
                                <ProgressBar Value="{Binding RamPercent}"
                                             Maximum="100" Height="4" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding RamText}"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryForegroundBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Files Found card -->
                    <Border Style="{StaticResource StatCardStyle}" Margin="5,0,5,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="{StaticResource WarningBrush}"
                                    CornerRadius="8,8,0,0"/>
                            <StackPanel Grid.Row="1" Margin="18,14,18,16">
                                <TextBlock Text="נמצאו בסריקה"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding TotalBytesFound,
                                               Converter={StaticResource BytesFormat}}"
                                           FontFamily="Consolas" FontSize="34" FontWeight="Bold"
                                           Foreground="{StaticResource WarningBrush}"
                                           Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding ScanResults.Count,
                                               StringFormat='{}{0} קבצים'}"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryForegroundBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Freed card -->
                    <Border Style="{StaticResource StatCardStyle}" Margin="10,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="{StaticResource SuccessBrush}"
                                    CornerRadius="8,8,0,0"/>
                            <StackPanel Grid.Row="1" Margin="18,14,18,16">
                                <TextBlock Text="שוחרר"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding TotalBytesFreed,
                                               Converter={StaticResource BytesFormat}}"
                                           FontFamily="Consolas" FontSize="34" FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}"
                                           Margin="0,0,0,10"/>
                                <TextBlock Text="מתחילת הפעלה"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryForegroundBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- ══ Scan Controls Card ══════════════════════════════════ -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>

                        <!-- Header row -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ניקוי קבצים זמניים"
                                           FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="מחיקה בטוחה של קבצי Temp, מטמון דפדפנים ודומ׳"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="רענן RAM"
                                    Command="{Binding RefreshRamCommand}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Padding="10,6" FontSize="11"
                                    VerticalAlignment="Top"/>
                        </Grid>

                        <!-- DryRun toggle -->
                        <Border Background="#0E1A14" CornerRadius="6" Padding="14,10"
                                Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource WarningBrush}"
                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="מצב בדיקה בלבד — אין מחיקה בפועל"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource WarningBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding IsDryRun}"
                                          IsEnabled="{Binding IsScanning,
                                              Converter={StaticResource InverseBool}}"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Progress area (only during scan) -->
                        <Border Margin="0,0,0,14"
                                Visibility="{Binding IsScanning,
                                    Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="{Binding StatusText}"
                                               FontSize="12"
                                               Foreground="{StaticResource SecondaryForegroundBrush}"/>
                                    <TextBlock Text="{Binding ScanProgress,
                                                   Converter={StaticResource PercentFormat}}"
                                               FontFamily="Consolas" FontSize="12"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               HorizontalAlignment="Left"/>
                                </Grid>
                                <ProgressBar Value="{Binding ScanProgress}"
                                             Maximum="100" Height="6"/>
                            </StackPanel>
                        </Border>

                        <!-- Status text (not scanning) -->
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryForegroundBrush}"
                                   Margin="0,0,0,14"
                                   Visibility="{Binding IsScanning,
                                       Converter={StaticResource InverseBool},
                                       ConverterParameter=visibility}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Action buttons -->
                        <StackPanel Orientation="Horizontal">
                            <Button Content="סרוק"
                                    Command="{Binding StartScanCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,0,10,0"/>
                            <Button Content="בצע ניקוי"
                                    Command="{Binding ExecuteCleaningCommand}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Margin="0,0,10,0"/>
                            <Button Content="בטל"
                                    Command="{Binding CancelScanCommand}"
                                    Style="{StaticResource GhostButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ══ Scan Results ════════════════════════════════════════ -->
                <Border Style="{StaticResource CardStyle}"
                        Visibility="{Binding ScanResults.Count,
                            Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <!-- Results header -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="תוצאות הסריקה"
                                           FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ScanResults.Count,
                                               StringFormat='{}{0} רשומות'}"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Results list -->
                        <ListView ItemsSource="{Binding ScanResults}"
                                  MaxHeight="280"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="נתיב" Width="400">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayPath}"
                                                           TextTrimming="CharacterEllipsis"
                                                           FontSize="12" MaxWidth="400"
                                                           Foreground="{Binding StatusBrush}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="גודל" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SizeDisplay}"
                                                           FontFamily="Consolas" FontSize="12"
                                                           Foreground="{StaticResource SecondaryForegroundBrush}"
                                                           HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="סטטוס" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding BadgeBrush}"
                                                        CornerRadius="4" Padding="7,3">
                                                    <TextBlock Text="{Binding StatusLabel}"
                                                               Foreground="White"
                                                               FontSize="10" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
