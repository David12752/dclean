<UserControl x:Class="DClean.UI.Views.DriverAuditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- Header -->
            <TextBlock Text="ביקורת דרייברים" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="סקירת כל הדרייברים המותקנים וייצוא גיבוי"
                       Foreground="#A0A0B0" FontSize="13" Margin="0,0,0,20"/>

            <!-- Toolbar -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,12">
                        <Button Content="סרוק דרייברים"
                                Command="{Binding LoadCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="ייצא גיבוי (DISM)"
                                Command="{Binding ExportCommand}"
                                Style="{StaticResource GhostButtonStyle}" Margin="0,0,16,0"/>
                        <CheckBox Content="הצג לא חתומים בלבד"
                                  IsChecked="{Binding ShowUnsigned}"
                                  Foreground="{StaticResource ForegroundBrush}"
                                  VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="200" Style="{StaticResource SearchBoxStyle}"
                                 Tag="חפש לפי שם / ספק..."/>
                    </WrapPanel>

                    <ProgressBar IsIndeterminate="{Binding IsLoading}" Height="4"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>

                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{StaticResource ForegroundBrush}" FontSize="13"/>
                </StackPanel>
            </Border>

            <!-- Driver List -->
            <Border Style="{StaticResource CardStyle}">
                <ListView ItemsSource="{Binding FilteredDrivers}"
                          MaxHeight="520" Background="Transparent" BorderThickness="0"
                          VirtualizingPanel.IsVirtualizing="True">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="התקן" Width="260"
                                DisplayMemberBinding="{Binding DeviceName}"/>
                            <GridViewColumn Header="ספק" Width="160"
                                DisplayMemberBinding="{Binding Provider}"/>
                            <GridViewColumn Header="גרסה" Width="110"
                                DisplayMemberBinding="{Binding Version}"/>
                            <GridViewColumn Header="תאריך" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DriverDate, StringFormat=dd/MM/yyyy}"
                                                   Foreground="{StaticResource ForegroundBrush}" FontSize="12"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="קטגוריה" Width="110"
                                DisplayMemberBinding="{Binding DeviceClass}"/>
                            <GridViewColumn Header="חתום" Width="60">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="14">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="✅"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSigned}" Value="False">
                                                            <Setter Property="Text" Value="⚠️"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding"   Value="4,3"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSigned}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
