<UserControl x:Class="DClean.UI.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Page Header ══════════════════════════════════════════════ -->
        <Border Grid.Row="0" Padding="28,22,28,18"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="יומן פעולות" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="רישום כל פעולות הסריקה, הניקוי וסיום התהליכים"
                               FontSize="12" Foreground="{StaticResource MutedBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="ייצוא CSV"
                            Command="{Binding ExportCommand}"
                            Style="{StaticResource GhostButtonStyle}"
                            Margin="0,0,8,0" Padding="12,7"/>
                    <Button Content="נקה יומן"
                            Command="{Binding ClearCommand}"
                            Style="{StaticResource GhostButtonStyle}"
                            Padding="12,7"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Log entries -->
        <Border Grid.Row="1" Margin="28,16,28,20" Style="{StaticResource CardStyle}">
            <ListView ItemsSource="{Binding LogEntries}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="זמן" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Timestamp}"
                                               FontFamily="Consolas" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="רמה" Width="76">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding LevelBrush}"
                                            CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{Binding Level}"
                                                   Foreground="White"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="הודעה" Width="500">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Message}"
                                               FontSize="12"
                                               Foreground="{StaticResource ForegroundBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="500"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</UserControl>
