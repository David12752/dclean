<UserControl x:Class="DClean.UI.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DClean.UI.ViewModels"
             FlowDirection="RightToLeft">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="28,20,28,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="מנהל הפעלה" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource ForegroundBrush}"/>
                    <TextBlock Text="ניהול Run keys · שירותים · משימות מתוזמנות · תיקיות הפעלה"
                               FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="רענן" Command="{Binding LoadCommand}"
                        Style="{StaticResource GhostButtonStyle}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="28,16,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}"
                    Padding="14,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SearchBoxStyle}"
                             Tag="חפש לפי שם או ספק..."
                             MaxWidth="320"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="✅ הפעל" Command="{Binding EnableCommand}"
                                Style="{StaticResource GhostButtonStyle}"
                                Padding="10,5" Margin="0,0,6,0"/>
                        <Button Content="🚫 השבת" Command="{Binding DisableCommand}"
                                Style="{StaticResource GhostButtonStyle}"
                                Padding="10,5" Margin="0,0,6,0"/>
                        <Button Content="⏱️ עכב הפעלה" Command="{Binding DelayStartCommand}"
                                Style="{StaticResource GhostButtonStyle}"
                                Padding="10,5"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status bar -->
            <TextBlock Grid.Row="1" Text="{Binding StatusText}"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12" Margin="2,0,0,8"/>

            <!-- Items list -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                <ListView ItemsSource="{Binding FilteredItems}"
                          SelectedItem="{Binding SelectedItem}"
                          Background="Transparent" BorderThickness="0"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="שם" Width="220">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:StartupItemViewModel}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource ForegroundBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="210"/>
                                            <TextBlock Text="{Binding Publisher}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="210"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="מצב" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:StartupItemViewModel}">
                                        <Border CornerRadius="5" Padding="8,3"
                                                Background="{Binding StatusBrush}">
                                            <TextBlock Text="{Binding StatusLabel}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#0A1018"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="מקור" Width="155">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:StartupItemViewModel}">
                                        <Border CornerRadius="4" Padding="7,2"
                                                Background="{StaticResource BorderBrush}">
                                            <TextBlock Text="{Binding SourceLabel}"
                                                       FontFamily="Consolas" FontSize="10"
                                                       Foreground="{StaticResource MutedBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="נתיב / פקודה" Width="360">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:StartupItemViewModel}">
                                        <TextBlock Text="{Binding Command}"
                                                   FontFamily="Consolas" FontSize="10"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="355"
                                                   ToolTip="{Binding Command}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </Grid>
    </Grid>
</UserControl>
