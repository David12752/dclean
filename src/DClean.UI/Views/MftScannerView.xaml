<UserControl x:Class="DClean.UI.Views.MftScannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DClean.UI.ViewModels"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="28,20,28,0">
            <StackPanel>
                <TextBlock Text="סורק קבצים גדולים וכפולים" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource ForegroundBrush}"/>
                <TextBlock Text="אתר קבצים גדולים · זהה כפולים · פנה שטח דיסק"
                           FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Controls bar -->
        <Border Grid.Row="1" Margin="28,12,28,0"
                Style="{StaticResource CardStyle}" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Row 1: Roots + size threshold -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,0,8">
                    <TextBlock Text="נתיבים:" Foreground="{StaticResource MutedBrush}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding ScanRoots, UpdateSourceTrigger=PropertyChanged}"
                             Width="280" Style="{StaticResource SearchBoxStyle}"
                             Tag="C:\;D:\"/>
                    <TextBlock Text="גודל מינימלי (MB):" Foreground="{StaticResource MutedBrush}"
                               FontSize="12" VerticalAlignment="Center" Margin="14,0,8,0"/>
                    <TextBox Text="{Binding MinSizeMb, UpdateSourceTrigger=PropertyChanged}"
                             Width="60" TextAlignment="Center"/>
                </StackPanel>

                <!-- Row 1: Actions -->
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="🔍 סרוק" Command="{Binding ScanCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="16,7" Margin="0,0,8,0"/>
                    <Button Content="✋ עצור" Command="{Binding CancelScanCommand}"
                            Style="{StaticResource GhostButtonStyle}"
                            Padding="10,7"/>
                </StackPanel>

                <!-- Row 2: Options + progress -->
                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                    <CheckBox IsChecked="{Binding FindDuplicates}"
                              Content="זהה קבצים כפולים (איטי יותר)"
                              Foreground="{StaticResource MutedBrush}" FontSize="12"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding StatusText}"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="340"/>
            </Grid>
        </Border>

        <!-- Progress bar -->
        <ProgressBar Grid.Row="2" Margin="28,6,28,0" Height="4"
                     Value="{Binding Progress}" Maximum="100"
                     Foreground="{StaticResource PrimaryBrush}"
                     Background="{StaticResource SurfaceBrush}"/>

        <!-- Tab results -->
        <Grid Grid.Row="3" Margin="28,10,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tab bar -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Padding="16,7" Margin="0,0,6,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="0">
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock>
                        <Run Text="קבצים גדולים"/>
                        <Run Text=" ("/>
                        <Run Text="{Binding LargeFiles.Count, Mode=OneWay}"/>
                        <Run Text=")"/>
                    </TextBlock>
                    <Button.Command>
                        <Binding Path="DataContext" RelativeSource="{RelativeSource Self}"/>
                    </Button.Command>
                    <Button.CommandParameter>0</Button.CommandParameter>
                    <Button.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding DataContext.SetActiveTabCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="0"/>
                    </Button.InputBindings>
                </Button>

                <Button Padding="16,7">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="1">
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock>
                        <Run Text="קבצים כפולים"/>
                        <Run Text=" ("/>
                        <Run Text="{Binding DupGroups.Count, Mode=OneWay}"/>
                        <Run Text=")"/>
                    </TextBlock>
                    <Button.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding DataContext.SetActiveTabCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="1"/>
                    </Button.InputBindings>
                </Button>
            </StackPanel>

            <!-- Large files tab -->
            <Border Grid.Row="1" Padding="0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Border Grid.Row="0" Padding="14,8"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{StaticResource BorderBrush}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="בחר הכל" Command="{Binding SelectAllLargeFilesCommand}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Padding="8,4" FontSize="11" Margin="0,0,6,0"/>
                            <Button Content="בטל בחירה" Command="{Binding DeselectAllLargeFilesCommand}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Padding="8,4" FontSize="11" Margin="0,0,6,0"/>
                            <Button Content="🗑️ מחק נבחרים"
                                    Command="{Binding DeleteSelectedLargeFilesCommand}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Padding="10,4" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <ListView Grid.Row="1" ItemsSource="{Binding LargeFiles}"
                              Background="Transparent" BorderThickness="0"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="34">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:LargeFileItemViewModel}">
                                            <CheckBox IsChecked="{Binding IsSelected}"
                                                      HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="שם קובץ" Width="280">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:LargeFileItemViewModel}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource ForegroundBrush}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="270"/>
                                                <TextBlock Text="{Binding Directory}"
                                                           FontSize="10" FontFamily="Consolas"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="270"
                                                           ToolTip="{Binding Path}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="גודל" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:LargeFileItemViewModel}">
                                            <TextBlock Text="{Binding SizeText}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       HorizontalAlignment="Left"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="סיומת" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:LargeFileItemViewModel}">
                                            <Border Background="{StaticResource BorderBrush}"
                                                    CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding ExtensionBadge}"
                                                           FontSize="10" FontFamily="Consolas"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="שונה לאחרונה" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:LargeFileItemViewModel}">
                                            <TextBlock Text="{Binding LastModified}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedBrush}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <!-- Duplicates tab -->
            <Border Grid.Row="1" Padding="0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Border Grid.Row="0" Padding="14,8"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{StaticResource BorderBrush}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="🗑️ מחק כפולים נבחרים"
                                    Command="{Binding DeleteSelectedDupFilesCommand}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Padding="10,4" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding DupGroups}">
                        <ItemsControl.Template>
                            <ControlTemplate>
                                <ScrollViewer CanContentScroll="True">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DuplicateGroupViewModel}">
                                <Border Margin="0,0,0,1"
                                        BorderThickness="0,0,0,1"
                                        BorderBrush="{StaticResource BorderBrush}">
                                    <Expander IsExpanded="True">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Hash: "
                                                           Foreground="{StaticResource MutedBrush}"
                                                           FontSize="11"/>
                                                <TextBlock Text="{Binding Hash}"
                                                           FontFamily="Consolas" FontSize="11"
                                                           Foreground="{StaticResource PrimaryBrush}"
                                                           Margin="0,0,16,0"/>
                                                <TextBlock Text="בזבוז: "
                                                           Foreground="{StaticResource MutedBrush}"
                                                           FontSize="11"/>
                                                <TextBlock Text="{Binding WastedText}"
                                                           FontWeight="SemiBold" FontSize="11"
                                                           Foreground="#FF4D5B"/>
                                            </StackPanel>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding Files}" Margin="24,4,0,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:LargeFileItemViewModel}">
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="80"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                                  Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Path}"
                                                                   FontFamily="Consolas" FontSize="11"
                                                                   Foreground="{StaticResource ForegroundBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Path}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
