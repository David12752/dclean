<UserControl x:Class="DClean.UI.Views.ProcessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Page Header ══════════════════════════════════════════════ -->
        <Border Grid.Row="0" Padding="28,22,28,18"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="ניהול תהליכים"
                               FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="עיון בתהליכים פעילים, פינוי זיכרון וסיום מבוקר"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>
                <!-- Process count badge -->
                <Border Grid.Column="1" CornerRadius="20" Padding="14,6"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Processes.Count}"
                                   FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="תהליכים"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryForegroundBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══ Body ══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="28,16,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Action Bar ────────────────────────────────────────── -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="רענן רשימה"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,8,0"/>

                    <Button Grid.Column="1"
                            Content="פנה זיכרון"
                            Command="{Binding TrimSelectedCommand}"
                            Style="{StaticResource GhostButtonStyle}"
                            Margin="0,0,8,0"/>

                    <Button Grid.Column="2"
                            Content="סיים תהליך"
                            Command="{Binding TerminateSelectedCommand}"
                            Style="{StaticResource DangerButtonStyle}"/>

                    <!-- Spacer -->
                    <TextBlock Grid.Column="3"/>

                    <!-- Status -->
                    <TextBlock Grid.Column="4"
                               Text="{Binding StatusText}"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryForegroundBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ── Process List ──────────────────────────────────────── -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <ListView ItemsSource="{Binding Processes}"
                          SelectedItem="{Binding SelectedProcess}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.View>
                        <GridView>

                            <!-- Process name + status chips -->
                            <GridViewColumn Header="תהליך" Width="240">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                            <Border CornerRadius="4" Padding="5,2"
                                                    Background="#2A0D12"
                                                    Visibility="{Binding IsCritical,
                                                        Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="קריטי"
                                                           Foreground="{StaticResource DangerBrush}"
                                                           FontSize="9" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border CornerRadius="4" Padding="5,2"
                                                    Background="#1E1800" Margin="4,0,0,0"
                                                    Visibility="{Binding IsProtected,
                                                        Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="מוגן"
                                                           Foreground="{StaticResource WarningBrush}"
                                                           FontSize="9" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- PID -->
                            <GridViewColumn Header="PID" Width="72">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Pid}"
                                                   FontFamily="Consolas" FontSize="12"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Working Set -->
                            <GridViewColumn Header="זיכרון (RAM)" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding WorkingSetDisplay}"
                                                   FontFamily="Consolas" FontSize="12"
                                                   Foreground="{StaticResource SecondaryForegroundBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <!-- ── Safety Strip ──────────────────────────────────────── -->
            <Border Grid.Row="2" Style="{StaticResource WarnStripStyle}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource WarningBrush}"
                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource WarningBrush}"
                               TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="שים לב: "/>
                        <Run Text="תהליכים המסומנים כ'קריטי' או 'מוגן' אינם ניתנים לסיום. סיום תהליכים שגויים עלול לגרום לאי-יציבות במערכת."/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
