<UserControl x:Class="DClean.UI.Views.UninstallerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="28,20,28,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="מסיר התקנות" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource ForegroundBrush}"/>
                    <TextBlock Text="הסרה מלאה כולל שאריות קבצים ורג'יסטרי"
                               FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="רענן רשימה" VerticalAlignment="Center"
                        Command="{Binding LoadAppsCommand}"
                        Style="{StaticResource GhostButtonStyle}"/>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="28,16,28,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: App list -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search box -->
                <TextBox Grid.Row="0" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SearchBoxStyle}"
                         Tag="חפש יישום..."
                         Margin="0,0,0,10"/>

                <!-- Loading overlay -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
                    <Grid>
                        <TextBlock Text="טוען..." Visibility="{Binding IsLoading,
                                   Converter={StaticResource BoolToVisibility}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>

                        <ListBox ItemsSource="{Binding Filtered}"
                                 SelectedItem="{Binding SelectedApp}"
                                 Background="Transparent" BorderThickness="0"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                        BorderThickness="0,0,0,1"
                                                        BorderBrush="{StaticResource BorderBrush}">
                                                    <ContentPresenter Margin="12,10"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#141D2A"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#0B2030"/>
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding DisplayName}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource ForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <Border Grid.Row="0" Grid.Column="1"
                                                CornerRadius="3" Padding="5,2"
                                                Margin="6,0,0,0"
                                                Background="{Binding TypeBrush}">
                                            <TextBlock Text="{Binding TypeBadge}"
                                                       FontSize="9" FontWeight="Bold"
                                                       Foreground="#0A1018"/>
                                        </Border>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Margin="0,3,0,0" FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Publisher}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding SizeText}"/>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right: Details + actions -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Selected app info -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="בחר יישום מהרשימה"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="14" HorizontalAlignment="Center"
                                       Margin="0,20">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedApp}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedApp}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Text="{Binding SelectedApp.DisplayName}"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource ForegroundBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding SelectedApp.Publisher}"
                                               Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                    <TextBlock Text=" · " Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding SelectedApp.Version}"
                                               Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                    <TextBlock Text=" · " Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding SelectedApp.SizeText}"
                                               Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                </StackPanel>

                                <Border Background="#0E1520" CornerRadius="8" Padding="12,10"
                                        Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="פרטי מקור וזיהוי"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource ForegroundBrush}"/>
                                        <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap">
                                            <Run Text="מקור: "/><Run Text="{Binding SelectedApp.DiscoverySource}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap">
                                            <Run Text="מפתח/מקור: "/><Run Text="{Binding SelectedApp.RegistryKeyPath}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap">
                                            <Run Text="מיקום התקנה: "/><Run Text="{Binding SelectedApp.InstallLocation}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap">
                                            <Run Text="uninstaller: "/><Run Text="{Binding SelectedApp.UninstallCommand}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Action buttons -->
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="🗑️  הסר התקנה"
                                            Command="{Binding UninstallCommand}"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Margin="0,0,10,0"/>
                                    <Button Content="🔍 סרוק שאריות"
                                            Command="{Binding ScanLeftoversCommand}"
                                            Style="{StaticResource GhostButtonStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Progress bar -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12"
                        Padding="16,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding StatusText}"
                                   Foreground="{StaticResource ForegroundBrush}" FontSize="13"
                                   Margin="0,0,0,8"/>
                        <ProgressBar Grid.Row="1" Value="{Binding Progress}"
                                     Height="6" Maximum="100"
                                     Foreground="{StaticResource PrimaryBrush}"
                                     Background="{StaticResource SurfaceBrush}"/>
                    </Grid>
                </Border>

                <!-- Leftovers -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Leftovers toolbar -->
                        <Border Grid.Row="0" Padding="14,10"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{StaticResource BorderBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="שאריות שנמצאו"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource ForegroundBrush}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="בחר הכל"
                                            Command="{Binding SelectAllLeftoversCommand}"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Padding="8,4" FontSize="11" Margin="0,0,6,0"/>
                                    <Button Content="בטל בחירה"
                                        Command="{Binding DeselectAllLeftoversCommand}"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Padding="8,4" FontSize="11" Margin="0,0,6,0"/>
                                    <Button Content="🗑️  מחק נבחרים"
                                            Command="{Binding DeleteLeftoversCommand}"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Padding="10,4" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Leftovers list -->
                        <ListView Grid.Row="1" ItemsSource="{Binding Leftovers}"
                                  SelectedItem="{Binding SelectedLeftover}"
                                  Background="Transparent" BorderThickness="0"
                                  VirtualizingPanel.IsVirtualizing="True">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="34">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}"
                                                          HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="סוג" Width="32">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TypeIcon}"
                                                           FontSize="14" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="נתיב" Width="340">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Path}"
                                                           FontFamily="Consolas" FontSize="11"
                                                           Foreground="{StaticResource ForegroundBrush}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="340"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="סיבה" Width="200">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Reason}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="ציון" Width="60">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="6,2"
                                                        Background="{Binding ScoreBrush}">
                                                    <TextBlock Text="{Binding ScoreText}"
                                                               FontSize="10" FontWeight="Bold"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <Border Grid.Row="2" Margin="12,0,12,12" Padding="12,10"
                                Background="#0E1520" CornerRadius="8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedLeftover}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="פירוט הפריט המסומן"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource ForegroundBrush}"/>
                                <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap">
                                    <Run Text="מקור: "/><Run Text="{Binding SelectedLeftover.Source}"/>
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap">
                                    <Run Text="אפליקציה: "/><Run Text="{Binding SelectedLeftover.RelatedApplication}"/>
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap">
                                    <Run Text="מיקום: "/><Run Text="{Binding SelectedLeftover.Location}"/>
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="{StaticResource ForegroundBrush}" TextWrapping="Wrap">
                                    <Run Text="קובץ/פריט בעייתי: "/><Run Text="{Binding SelectedLeftover.ProblematicItem}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Log -->
                <Border Grid.Row="3" Style="{StaticResource CardStyle}"
                        Margin="0,12,0,0" MaxHeight="120" Padding="0">
                    <ListBox ItemsSource="{Binding Log}"
                             Background="Transparent" BorderThickness="0"
                             FontFamily="Consolas" FontSize="11"
                             Foreground="{StaticResource MutedBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="12,3"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
