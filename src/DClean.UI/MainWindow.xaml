<Window x:Class="DClean.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DClean.UI.ViewModels"
        xmlns:views="clr-namespace:DClean.UI.Views"
        Title="DClean — ניקוי בטוח וניהול ביצועים"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="860"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <!-- DataTemplates: map ViewModel types to their View -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProcessViewModel}">
            <views:ProcessView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StartupViewModel}">
            <views:StartupView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogViewModel}">
            <views:LogView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0A0D12" Offset="0"/>
                <GradientStop Color="#101621" Offset="0.45"/>
                <GradientStop Color="#0B1017" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse Width="480" Height="480"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-140,-130,0,0" IsHitTestVisible="False" Opacity="0.14">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#2CF2D6" Offset="0"/>
                    <GradientStop Color="#002CF2D6" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse Width="420" Height="420"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-120,-120" IsHitTestVisible="False" Opacity="0.10">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#4B6BFF" Offset="0"/>
                    <GradientStop Color="#004B6BFF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Border Margin="16"
                CornerRadius="24"
                BorderBrush="#223047"
                BorderThickness="1"
                Background="#CC0B1017">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Column 0 = visually RIGHT (sidebar) in RTL -->
                    <ColumnDefinition Width="240"/>
                    <!-- Column 1 = visually LEFT (content area) -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ══════════════════════════════════════════════════════
                     SIDEBAR
                ══════════════════════════════════════════════════════ -->
                <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Background fill -->
            <Border Grid.RowSpan="3"
                    Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0"/>

            <!-- ── Brand ─────────────────────────────────────── -->
                <Border Grid.Row="0" Padding="22,26,22,22"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel>
                    <Border CornerRadius="999" Padding="10,5" Background="#121A24"
                        BorderBrush="#263245" BorderThickness="1" HorizontalAlignment="Right"
                        Margin="0,0,0,14">
                    <TextBlock Text="ZERO-RISK CLEANUP" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"/>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <!-- Geometric mark: two overlapping squares -->
                        <Border Width="22" Height="22" CornerRadius="4"
                                Background="{StaticResource PrimaryBrush}"
                                Margin="0,0,10,0" VerticalAlignment="Center">
                            <Border Width="10" Height="10" CornerRadius="2"
                                    Background="#0A1512"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="DClean"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource ForegroundBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="ממשק תחזוקה בטוח, מהיר ומדויק"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="32,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- ── Navigation ────────────────────────────────── -->
            <StackPanel Grid.Row="1" Margin="0,10,0,0">

                <!-- ★ סריקה מקיפה — כפתור ראשי מודגש -->
                <Border Margin="14,10,14,4">
                    <Button Command="{Binding NavigateFullScanCommand}" Padding="0,12">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background"   Value="#1A6B3A"/>
                                <Setter Property="Foreground"   Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Cursor"       Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="10"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#22884A"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding ActiveNav}" Value="fullscan">
                                        <Setter Property="Background" Value="#22884A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontSize="15" VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="סרוק את כל המערכת" FontSize="13"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>

                <Separator Margin="20,8,20,2" Background="#2A3A30"/>

                <TextBlock Text="ראשי" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="22,4,0,6"/>

                <!-- לוח בקרה -->
                <Button Command="{Binding NavigateDashboardCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveNav}" Value="dashboard">
                                    <Setter Property="Background"      Value="#0C1922"/>
                                    <Setter Property="Foreground"      Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="FontWeight"      Value="SemiBold"/>
                                    <Setter Property="BorderBrush"     Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="לוח בקרה" FontSize="13"
                               Foreground="{Binding Foreground,
                                   RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>

                <!-- ניקוי קבצים -->
                <Button Command="{Binding NavigateDashboardCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveNav}" Value="dashboard">
                                    <Setter Property="Background"  Value="#0C1922"/>
                                    <Setter Property="Foreground"  Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="FontWeight"  Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="ניקוי קבצים" FontSize="13"
                               Foreground="{Binding Foreground,
                                   RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>

                <!-- ניהול תהליכים -->
                <Button Command="{Binding NavigateProcessesCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveNav}" Value="processes">
                                    <Setter Property="Background"  Value="#0C1922"/>
                                    <Setter Property="Foreground"  Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="FontWeight"  Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="ניהול תהליכים" FontSize="13"
                               Foreground="{Binding Foreground,
                                   RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>

                <Separator Margin="20,8"/>

                <TextBlock Text="מערכת" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="22,4,0,6"/>

                <!-- פריטי הפעלה -->
                <Button Command="{Binding NavigateStartupCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveNav}" Value="startup">
                                    <Setter Property="Background"  Value="#0C1922"/>
                                    <Setter Property="Foreground"  Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="FontWeight"  Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="פריטי הפעלה" FontSize="13"
                               Foreground="{Binding Foreground,
                                   RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>

                <!-- מסיר התקנות -->
                <Button Command="{Binding NavigateUninstallerCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveNav}" Value="uninstaller">
                                    <Setter Property="Background"  Value="#0C1922"/>
                                    <Setter Property="Foreground"  Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="FontWeight"  Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="מסיר התקנות" FontSize="13"
                               Foreground="{Binding Foreground,
                                   RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>

                <!-- מכוון ביצועים -->
                <Button Command="{Binding NavigatePerformanceTunerCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveNav}" Value="performance">
                                    <Setter Property="Background"  Value="#0C1922"/>
                                    <Setter Property="Foreground"  Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="FontWeight"  Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="מכוון ביצועים" FontSize="13"
                               Foreground="{Binding Foreground,
                                   RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>

                <!-- סורק קבצים -->
                <Button Command="{Binding NavigateMftScannerCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveNav}" Value="mftscanner">
                                    <Setter Property="Background"  Value="#0C1922"/>
                                    <Setter Property="Foreground"  Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="FontWeight"  Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="סורק קבצים" FontSize="13"
                               Foreground="{Binding Foreground,
                                   RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>

                <!-- מנקה מערכת -->
                <Button Command="{Binding NavigateDebloaterCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveNav}" Value="debloater">
                                    <Setter Property="Background"  Value="#0C1922"/>
                                    <Setter Property="Foreground"  Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="FontWeight"  Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="מנקה מערכת" FontSize="13"
                               Foreground="{Binding Foreground,
                                   RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>

                <!-- תפריט הקשר -->
                <Button Command="{Binding NavigateContextMenuCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveNav}" Value="contextmenu">
                                    <Setter Property="Background"  Value="#0C1922"/>
                                    <Setter Property="Foreground"  Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="FontWeight"  Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="תפריט הקשר" FontSize="13"
                               Foreground="{Binding Foreground,
                                   RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>

                <!-- מעדכן תוכנות -->
                <Button Command="{Binding NavigateWinGetUpdaterCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveNav}" Value="winget">
                                    <Setter Property="Background"  Value="#0C1922"/>
                                    <Setter Property="Foreground"  Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="FontWeight"  Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="עדכון תוכנות" FontSize="13"
                               Foreground="{Binding Foreground,
                                   RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>

                <!-- ביקורת דרייברים -->
                <Button Command="{Binding NavigateDriverAuditorCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveNav}" Value="drivers">
                                    <Setter Property="Background"  Value="#0C1922"/>
                                    <Setter Property="Foreground"  Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="FontWeight"  Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="דרייברים" FontSize="13"
                               Foreground="{Binding Foreground,
                                   RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>

                <!-- ניקוי DAW -->
                <Button Command="{Binding NavigateDawCleanerCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveNav}" Value="daw">
                                    <Setter Property="Background"  Value="#0C1922"/>
                                    <Setter Property="Foreground"  Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="FontWeight"  Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="ניקוי DAW" FontSize="13"
                               Foreground="{Binding Foreground,
                                   RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>

                <!-- ניהול שמע -->
                <Button Command="{Binding NavigateAudioEndpointCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveNav}" Value="audio">
                                    <Setter Property="Background"  Value="#0C1922"/>
                                    <Setter Property="Foreground"  Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="FontWeight"  Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="ניהול שמע" FontSize="13"
                               Foreground="{Binding Foreground,
                                   RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>

                <!-- איפוס רשת -->
                <Button Command="{Binding NavigateNetworkFlushCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveNav}" Value="network">
                                    <Setter Property="Background"  Value="#0C1922"/>
                                    <Setter Property="Foreground"  Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="FontWeight"  Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="איפוס רשת" FontSize="13"
                               Foreground="{Binding Foreground,
                                   RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>

                <!-- WinSxS + SFC -->
                <Button Command="{Binding NavigateComponentStoreCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveNav}" Value="compstore">
                                    <Setter Property="Background"  Value="#0C1922"/>
                                    <Setter Property="Foreground"  Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="FontWeight"  Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="WinSxS / SFC" FontSize="13"
                               Foreground="{Binding Foreground,
                                   RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>

                <!-- S.M.A.R.T. כוננים -->
                <Button Command="{Binding NavigateSmartAnalyzerCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveNav}" Value="smart">
                                    <Setter Property="Background"  Value="#0C1922"/>
                                    <Setter Property="Foreground"  Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="FontWeight"  Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="S.M.A.R.T." FontSize="13"
                               Foreground="{Binding Foreground,
                                   RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>

                <!-- יומן פעולות -->
                <Button Command="{Binding NavigateLogCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveNav}" Value="log">
                                    <Setter Property="Background"  Value="#0C1922"/>
                                    <Setter Property="Foreground"  Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="FontWeight"  Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="יומן פעולות" FontSize="13"
                               Foreground="{Binding Foreground,
                                   RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>

                <!-- הגדרות -->
                <Button Command="{Binding NavigateSettingsCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveNav}" Value="settings">
                                    <Setter Property="Background"  Value="#0C1922"/>
                                    <Setter Property="Foreground"  Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="FontWeight"  Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="הגדרות" FontSize="13"
                               Foreground="{Binding Foreground,
                                   RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </StackPanel>

            <!-- ── Footer: version ───────────────────────────── -->
            <Border Grid.Row="2"
                    Padding="22,14"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                             Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource MutedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Dashboard.IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource PrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="שירות: מנותק"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Dashboard.IsConnected}" Value="True">
                                        <Setter Property="Text" Value="שירות: מחובר"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text=" · v1.0" FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="6,0,0,0"/>
                </StackPanel>
            </Border>
                </Grid>

                <!-- ══════════════════════════════════════════════════════
                     CONTENT AREA
                ══════════════════════════════════════════════════════ -->
                <Border Grid.Column="1" Margin="0"
                        Background="#82101822"
                        BorderBrush="#1D2B3F"
                        BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Padding="24,18"
                                BorderBrush="#223047"
                                BorderThickness="0,0,0,1"
                                Background="#66141B27">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="שליטה בטוחה בניקוי, שחרור משאבים ותחזוקת Windows"
                                               FontSize="20" FontWeight="SemiBold"
                                               Foreground="{StaticResource ForegroundBrush}"/>
                                    <TextBlock Text="הגנות פעילות כברירת מחדל · אישור כפול לפעולות הרסניות · ממשק עברי מלא"
                                               FontSize="12" Margin="0,6,0,0"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Padding="14,8"
                                        CornerRadius="14"
                                        BorderBrush="#2A3448"
                                        BorderThickness="1"
                                        Background="#101823"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Dashboard.IsConnected}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource PrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Dashboard.ConnectionStatus}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource ForegroundBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <ContentControl Grid.Row="1"
                                        Content="{Binding CurrentView}"
                                        Focusable="False"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
